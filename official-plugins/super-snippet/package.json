{
  "name": "super-snippet-plugin",
  "version": "1.0.0",
  "description": "超级文本片段 - 快速插入预定义文本片段到任意应用",
  "author": {
    "name": "UniHub Team",
    "email": "team@unihub.dev",
    "url": "https://github.com/unihub"
  },
  "keywords": [
    "snippet",
    "text",
    "paste",
    "快捷输入",
    "文本片段",
    "代码片段"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "node scripts/package.js"
  },
  "unihub": {
    "id": "com.unihub.super-snippet",
    "name": "超级文本片段",
    "icon": "https://api.iconify.design/fluent-emoji/high-voltage.svg",
    "category": "tool",
    "permissions": [
      "clipboard",
      "storage",
      "system"
    ],
    "entry": "dist/index.html"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "lucide-vue-next": "^0.562.0",
    "radix-vue": "^1.9.17",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^5.2.1",
    "archiver": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.3"
  }
}
